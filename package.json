{
  "name": "dsh-proxy-embedded",
  "version": "0.1.3",
  "description": "粘贴订阅链接即用：插件自带 mihomo 内核，自动起代理并把 DSH 出站（含 web_fetch）接管过去，不用再单独开 Clash。支持 Clash / V2Ray / Shadowrocket / sing-box / Surge 订阅。 / Paste a subscription link; the plugin starts its embedded mihomo core and routes DSH outbound (including web_fetch) through it — no separate Clash client needed.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core.js",
    "./subscription": "./lib/subscription.js",
    "./convert": "./lib/convert.js",
    "./harness": "./lib/harness.js",
    "./route": "./lib/route.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "proxy",
    "mihomo",
    "clash",
    "subscription",
    "订阅",
    "代理"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-http-proxy": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.5-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-http-proxy": { "optional": true },
    "@deepseek-ai/dsh-launch-environment": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dsh": {
    "category": "extension",
    "displayName": "内嵌代理 · 订阅即用",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  }
}
